APP_NAME=MetoHub
APP_ENV=production
# Keep the existing production key. Generate a key only for a brand-new installation.
APP_KEY=
APP_DEBUG=false
APP_URL=https://betametohub.metora.in
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# Enter your info@metora.in mailbox provider's SMTP details on the server.
# smtp uses STARTTLS on port 587; use smtps with port 465 if your provider requires it.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=info@metora.in
MAIL_FROM_NAME=MetoHub
MAIL_EHLO_DOMAIN=betametohub.metora.in

# Optional platform subscriptions (separate from storefront checkout).
RAZORPAY_KEY=
RAZORPAY_SECRET=

# Optional WhatsApp notifications.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_OWNER_NUMBER=

# Optional Google login; register this callback with the provider before enabling.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=https://betametohub.metora.in/auth/google/callback

BLOG_API_ENDPOINT=https://blog.metora.in/api/v1/projects/blogs
BLOG_API_KEY=
BLOG_ASSET_URL=https://blog.metora.in

# Set false on staging to prevent search indexing.
SEARCH_INDEXABLE=true

# Owner order emails and Web Push. Keep the private key on the server.
ORDER_NOTIFICATIONS_QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=300
WEBPUSH_VAPID_SUBJECT=mailto:info@metora.in
WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_PRIVATE_KEY=
